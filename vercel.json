{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/users",
      "destination": "/api/users"
    },
    {
      "source": "/api/items",
      "destination": "/api/items"
    },
    {
      "source": "/api/bookings",
      "destination": "/api/bookings"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/frontend/index.html"
    }
  ]
}
